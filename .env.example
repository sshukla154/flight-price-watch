# .env.example — template only. Variable NAMES, never real values.
# Copy to .env for a local test run (already gitignored) and fill in
# real secrets there. Never commit a real value.

# From serpapi.com's dashboard (Free plan: 250 searches/month).
SERPAPI_KEY=

# Your own WhatsApp number, e.g. +311234567890 (international format).
CALLMEBOT_PHONE=

# The key CallMeBot's bot sent you after the one-time WhatsApp activation
# handshake — see README.md for the exact steps.
CALLMEBOT_APIKEY=
