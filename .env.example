# .env.example — template only. Variable NAMES, never real values.
# Copy to .env for a local test run (already gitignored) and fill in
# real secrets there. Never commit a real value.

# From serpapi.com's dashboard (Free plan: 250 searches/month).
SERPAPI_KEY=

# Your own WhatsApp number, e.g. +311234567890 (international format).
CALLMEBOT_PHONE=

# The key CallMeBot's bot sent you after the one-time WhatsApp activation
# handshake — see README.md for the exact steps.
CALLMEBOT_APIKEY=

# Gmail account used for email notifications (sends to itself). Needs
# 2-Step Verification enabled and an App Password generated at
# myaccount.google.com/apppasswords — see README.md for exact steps.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Notification channel picks itself: "email" when GITHUB_ACTIONS=true
# (set automatically by GitHub Actions), "whatsapp" otherwise (e.g.
# here, running locally). Uncomment to force one regardless of
# environment — useful to test the email path locally, or vice versa.
# FLIGHT_NOTIFY_CHANNEL=whatsapp
